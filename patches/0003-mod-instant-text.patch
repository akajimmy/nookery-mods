+// Instant Text: shows each text box in one frame while the villager keeps speaking at the normal pace, and an
+// option to skip every timed pause. The game side is in src/game/m_msg_cursol.c_inc.
+
+#include "acgc/mods.hpp"
+#include "mods/instant_text.h"
+
+#include <memory>
+
+extern "C" int g_mod_instant_text = 0;
+extern "C" int g_mod_skip_text_pauses = 0;
+
+namespace {
+using borealis::config::Var;
+
+std::unique_ptr<Var<bool>> s_instant;
+std::unique_ptr<Var<bool>> s_skipPauses;
+
+void create_settings(borealis::config::Registry& registry) {
+    s_instant = std::make_unique<Var<bool>>(registry, "gameplay.instantText", false);
+    s_skipPauses = std::make_unique<Var<bool>>(registry, "gameplay.skipTextPauses", false);
+}
+
+void apply_settings() {
+    g_mod_instant_text = s_instant->get() ? 1 : 0;
+    g_mod_skip_text_pauses = s_skipPauses->get() ? 1 : 0;
+}
+
+void build_settings(acgc::mods::SettingsPage page, acgc::mods::SettingsBuilder& builder) {
+    if (page == acgc::mods::SettingsPage::Gameplay) {
+        builder.add_bool(*s_instant, "mods.instant_text.label", "mods.instant_text.help");
+        builder.add_bool(*s_skipPauses, "mods.instant_text.skip_pauses", "mods.instant_text.skip_pauses_help");
+    }
+}
+} // namespace
+
+ACGC_REGISTER_MOD(instant_text, .name = "Instant Text", .create_settings = create_settings,
+                  .apply_settings = apply_settings, .build_settings = build_settings);
