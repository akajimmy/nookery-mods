+static f32 mMsg_order_busy_frames = 0.0f;
+
+/* Instant text fills the window in one frame, up to the next control code. */
+static int mMsg_instant_text_active(mMsg_Window_c* msg_p) {
+  (void)msg_p;
+  return g_mod_instant_text && !mEv_IsTitleDemo();
+}
+
+/* With instant text, the villager voice walks the visible text at the normal speaking pace on its own cursor, and
+ * keeps going while the window waits for a button. It is cut off when the page changes or the window closes. */
+static void mMsg_instant_voice_update(mMsg_Window_c* msg_p) {
+  static int voice_pos = -1;
+  static int page_start = -1;
+  static int page_msg_no = -1;
+  static f32 voice_timer = 0.0f;
+  static int forced_voice = FALSE;
+  int showing;
+  int speaking;
+
+  if (forced_voice) {
+    msg_p->force_voice_enable_flag = FALSE;
+    forced_voice = FALSE;
+  }
+
+  showing = mMsg_instant_text_active(msg_p) && msg_p->msg_data != NULL && msg_p->msg_data->data_loaded &&
+            msg_p->draw_flag && (msg_p->main_index == mMsg_INDEX_CURSOL || msg_p->main_index == mMsg_INDEX_NORMAL);
+
+  if (!showing || msg_p->msg_data->msg_no != page_msg_no || msg_p->start_text_cursor_idx != page_start) {
+    /* Cut off a voice that was still speaking the previous page. */
+    if (voice_pos >= 0 && msg_p->free_str_color_idx[3] == 1) {
+      mMsg_sound_voice_endcode_set(msg_p);
+      mMsg_Unset_NowUtter(msg_p);
+    }
+    voice_pos = -1;
+    voice_timer = 0.0f;
+    if (!showing) {
+      page_msg_no = -1;
+      page_start = -1;
+      return;
+    }
+    page_msg_no = msg_p->msg_data->msg_no;
+    page_start = msg_p->start_text_cursor_idx;
+    voice_pos = page_start;
+  }
+
+  speaking = voice_pos < msg_p->end_text_cursor_idx;
+  if (!speaking) {
+    /* Finished the page; end the voice once the text has stopped too. */
+    if (msg_p->main_index != mMsg_INDEX_CURSOL && msg_p->free_str_color_idx[3] == 1) {
+      mMsg_sound_voice_endcode_set(msg_p);
+    }
+    mMsg_Unset_NowUtter(msg_p);
+    return;
+  }
+
+  mMsg_Set_NowUtter(msg_p);
+  voice_timer -= (f32)gamePT->graph->dt_num_60fps_frames;
+  while (voice_timer <= 0.0f && voice_pos < msg_p->end_text_cursor_idx) {
+    u8 code = msg_p->msg_data->text_buf.data[voice_pos];
+    int cur = voice_pos;
+
+    voice_pos += mMsg_Set_SizeCode(msg_p, voice_pos);
+    if (code == CHAR_CONTROL_CODE || code == CHAR_MESSAGE_TAG || code == CHAR_NEW_LINE) {
+      continue;
+    }
+    /* Normal text speaks a character every 2 frames, fast text every frame. */
+    voice_timer += g_pc_settings.fast_text ? 1.0f : 2.0f;
+    if (mMsg_sound_CodeVoice(msg_p, cur)) {
+      msg_p->force_voice_enable_flag = TRUE;
+      forced_voice = TRUE;
+    }
+    break;
+  }
+}
