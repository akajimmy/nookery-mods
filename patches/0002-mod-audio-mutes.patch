+/* PC mute settings per group: 0 = sound effects, 1 and 3 = music (crossfade pair), 2 = furniture instruments and
+ * gyroids (counted as sound effects), 4 = villager voices. */
+static f32 pc_group_gain(s32 index) {
+    switch (index) {
+        case 1:
+        case 3:
+            return g_mod_mute_music ? 0.0f : 1.0f;
+        case 4:
+            return g_mod_mute_voice ? 0.0f : 1.0f;
+        default:
+            return g_mod_mute_sfx ? 0.0f : 1.0f;
+    }
+}
+#endif
 
