+body {
+    width: 100%;
+    height: 100%;
+    margin: 0;
+    padding: 0;
+    overflow: visible;
+    pointer-events: none;
+    font-family: var(--font-family-body);
+    font-size: var(--font-size-base);
+}
+
+/* Mute status icons, lower left. Each icon shows while its mute is on. */
+mute-status {
+    position: absolute;
+    display: flex;
+    align-items: center;
+    left: 20dp;
+    bottom: 20dp;
+    padding: 0.3em 0.55em;
+    gap: 0.35em;
+    color: var(--color-text);
+    background-color: var(--color-surface);
