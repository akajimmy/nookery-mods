--- /dev/null
+++ b/pc/src/mods/audio_mutes.cpp
@@ -0,0 +1,150 @@
+// Audio Mutes: separate mutes for music, sound effects and villager voices, each with a hotkey, and small status
+// icons in the lower left. The mixing side is pc_group_gain in src/static/jaudio_NES/internal/effect.c.
+
+#include "acgc/mods.hpp"
+#include "mods/audio_mutes.h"
+
+#include "acgc/ui/ui.hpp"
+
+#include <borealis/ui/document.hpp>
+
+#include <memory>
+#include <string>
+
+extern "C" int g_mod_mute_music = 0;
+extern "C" int g_mod_mute_sfx = 0;
+extern "C" int g_mod_mute_voice = 0;
+
+namespace {
+using borealis::config::Var;
+
+struct Category {
+    const char* mute_key;
+    const char* hotkey_key;
+    const char* default_hotkey; // unbound in Nookery's default keyboard layout
+    const char* label;
+    const char* help;
+    int* flag;
+    std::unique_ptr<Var<bool>> mute;
+    std::unique_ptr<Var<std::string>> hotkey;
+};
+
+Category s_categories[] = {
+    { "audio.muteMusic", "audio.muteMusicKey", "M", "mods.audio_mutes.music", "mods.audio_mutes.music_help",
+      &g_mod_mute_music },
+    { "audio.muteSfx", "audio.muteSfxKey", "N", "mods.audio_mutes.sfx", "mods.audio_mutes.sfx_help",
+      &g_mod_mute_sfx },
+    { "audio.muteVoice", "audio.muteVoiceKey", "V", "mods.audio_mutes.voice", "mods.audio_mutes.voice_help",
+      &g_mod_mute_voice },
+};
+std::unique_ptr<Var<bool>> s_showIcons;
+bool s_iconsShown = true;
+
+void create_settings(borealis::config::Registry& registry) {
+    for (Category& category : s_categories) {
+        category.mute = std::make_unique<Var<bool>>(registry, category.mute_key, false);
+        category.hotkey =
+            std::make_unique<Var<std::string>>(registry, category.hotkey_key, std::string(category.default_hotkey));
+    }
+    s_showIcons = std::make_unique<Var<bool>>(registry, "audio.showMuteIcons", true);
+}
+
+void apply_settings() {
+    for (Category& category : s_categories) {
+        *category.flag = category.mute->get() ? 1 : 0;
+    }
+    s_iconsShown = s_showIcons->get();
+}
+
+template <int Index>
+void toggle() {
+    auto& mute = *s_categories[Index].mute;
+    mute.set(!mute.get());
+}
+
+void add_hotkeys(std::vector<acgc::mods::Hotkey>& hotkeys) {
+    hotkeys.push_back({ "mods.audio_mutes.music", s_categories[0].hotkey.get(), &toggle<0> });
+    hotkeys.push_back({ "mods.audio_mutes.sfx", s_categories[1].hotkey.get(), &toggle<1> });
+    hotkeys.push_back({ "mods.audio_mutes.voice", s_categories[2].hotkey.get(), &toggle<2> });
+}
+
+void build_settings(acgc::mods::SettingsPage page, acgc::mods::SettingsBuilder& builder) {
+    if (page != acgc::mods::SettingsPage::Audio) {
+        return;
+    }
+    builder.add_section("mods.audio_mutes.section");
+    for (Category& category : s_categories) {
+        builder.add_bool(*category.mute, category.label, category.help);
+    }
+    builder.add_bool(*s_showIcons, "mods.audio_mutes.show_icons", "mods.audio_mutes.show_icons_help");
+}
+
+// Lower-left status icons: one per muted category, shown only while something is muted.
+class MuteStatus final : public borealis::ui::Document {
+public:
+    MuteStatus() : Document(source(), true, acgc::ui::kScopeOverlay) {
+        if (mDocument != nullptr) {
+            mBar = mDocument->GetElementById("mute-status");
+            mIcons[0] = mDocument->GetElementById("mute-music");
+            mIcons[1] = mDocument->GetElementById("mute-sfx");
+            mIcons[2] = mDocument->GetElementById("mute-voice");
+        }
+    }
+
+    void show() override {
+        if (mDocument != nullptr) {
+            mDocument->Show(Rml::ModalFlag::None, Rml::FocusFlag::None, Rml::ScrollFlag::None);
+        }
+    }
+
+    void update() override {
+        const int flags[3] = { g_mod_mute_music, g_mod_mute_sfx, g_mod_mute_voice };
+        bool any = false;
+        for (int i = 0; i < 3; ++i) {
+            const bool on = s_iconsShown && flags[i] != 0;
+            any = any || on;
+            if (mIcons[i] != nullptr && on != mShown[i]) {
+                mIcons[i]->SetClass("on", on);
+                mShown[i] = on;
+            }
+        }
+        if (mBar != nullptr && any != mAny) {
+            mBar->SetClass("on", any);
+            mAny = any;
+        }
+    }
+
+private:
+    static Rml::String source() {
+        // music_off, volume_off and voice_over_off from Material Symbols.
+        return R"RML(
+<rml>
+<head>
+    <link type="text/rcss" href="res/rml/theme.rcss" />
+    <link type="text/rcss" href="res/rml/mods/audio_mutes.rcss" />
+</head>
+<body>
+    <mute-status id="mute-status">
+        <mute-icon id="mute-music">&#xe440;</mute-icon>
+        <mute-icon id="mute-sfx">&#xe04f;</mute-icon>
+        <mute-icon id="mute-voice">&#xe94a;</mute-icon>
+    </mute-status>
+</body>
+</rml>
+)RML";
+    }
+
+    Rml::Element* mBar = nullptr;
+    Rml::Element* mIcons[3] = {};
+    bool mShown[3] = {};
+    bool mAny = false;
+};
+
+std::unique_ptr<borealis::ui::Document> create_overlay() {
+    return std::make_unique<MuteStatus>();
+}
+} // namespace
+
+ACGC_REGISTER_MOD(audio_mutes, .name = "Audio Mutes", .create_settings = create_settings,
+                  .apply_settings = apply_settings, .add_hotkeys = add_hotkeys, .build_settings = build_settings,
+                  .create_overlay = create_overlay);
