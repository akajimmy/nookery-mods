+// Right-Click Aim: right-click turns the player toward the mouse cursor before interacting.
+// The game side is mCon_mouse_face_cursor in src/game/m_controller.c.
+
+#include "acgc/mods.hpp"
+#include "mods/right_click_aim.h"
+
+#include <memory>
+
+extern "C" int g_mod_right_click_aim = 0;
+
+namespace {
+using borealis::config::Var;
+
+std::unique_ptr<Var<bool>> s_enabled;
+
+void create_settings(borealis::config::Registry& registry) {
+    s_enabled = std::make_unique<Var<bool>>(registry, "input.rightClickFaceCursor", false);
+}
+
+void apply_settings() {
+    g_mod_right_click_aim = s_enabled->get() ? 1 : 0;
+}
+
+void build_settings(acgc::mods::SettingsPage page, acgc::mods::SettingsBuilder& builder) {
+    if (page == acgc::mods::SettingsPage::Controls) {
+        builder.add_bool(*s_enabled, "mods.right_click_aim.label", "mods.right_click_aim.help");
+    }
+}
+} // namespace
+
+ACGC_REGISTER_MOD(right_click_aim, .name = "Right-Click Aim", .create_settings = create_settings,
+                  .apply_settings = apply_settings, .build_settings = build_settings);
