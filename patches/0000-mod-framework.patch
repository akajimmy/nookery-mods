@@ -0,0 +1,73 @@
+#pragma once
+
+// Small mod framework: lets self-contained mods add settings, menu options, hotkeys and overlay documents
+// without editing shared files, so any combination of mods can be merged together.
+//
+// A mod lives in pc/src/mods/ (picked up by CMake automatically), keeps its strings in
+// pc/res/lang/mods/<mod>.json, and registers itself once:
+//
+//     ACGC_REGISTER_MOD(my_mod, .name = "My Mod", .create_settings = ..., .apply_settings = ...);
+
+#include <borealis/config.hpp>
+#include <borealis/config_codec.hpp> // so mods can create Var<T> settings
+
+#include <SDL3/SDL_events.h>
+
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace borealis::ui {
+class Document;
+}
+
+namespace acgc::mods {
+
+// Settings pages a mod can add options to.
+enum class SettingsPage {
+    Audio,    // Settings > Audio
+    Gameplay, // Settings > Gameplay
+    Controls, // Controls > Device > Options
+};
+
+// Adds a mod's options to a settings page. Keys are localization keys.
+class SettingsBuilder {
+public:
+    virtual ~SettingsBuilder() = default;
+    virtual void add_section(const char* label_key) = 0;
+    virtual void add_bool(borealis::config::Var<bool>& variable, const char* label_key, const char* help_key) = 0;
+};
+
+// A rebindable key, listed under Controls > Keyboard > Hotkeys.
+struct Hotkey {
+    const char* label_key;
+    borealis::config::Var<std::string>* key; // SDL scancode name, "" = unbound
+    void (*on_press)();
+};
+
+struct Mod {
+    const char* name = nullptr;
+    // Create the mod's config Vars on the registry. Called whenever the settings are (re)created, before loading.
+    void (*create_settings)(borealis::config::Registry& registry) = nullptr;
+    // Copy settings into whatever the game code reads. Called after loading and after every settings change.
+    void (*apply_settings)() = nullptr;
+    void (*add_hotkeys)(std::vector<Hotkey>& hotkeys) = nullptr;
+    void (*build_settings)(SettingsPage page, SettingsBuilder& builder) = nullptr;
+    // A passive document shown over the game, such as a HUD element.
+    std::unique_ptr<borealis::ui::Document> (*create_overlay)() = nullptr;
+};
+
+int register_mod(const Mod& mod);
+
+// Hooks called by the port.
+void create_settings(borealis::config::Registry& registry);
+void apply_settings();
+std::vector<Hotkey> hotkeys();
+void handle_hotkey_event(const SDL_Event& event);
+void build_settings(SettingsPage page, SettingsBuilder& builder);
+void create_overlays();
+
+} // namespace acgc::mods
+
+#define ACGC_REGISTER_MOD(id, ...)                                                                                     \
+    [[maybe_unused]] static const int acgc_mod_registered_##id = ::acgc::mods::register_mod(::acgc::mods::Mod{__VA_ARGS__})
