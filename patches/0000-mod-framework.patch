+// Adds mod options to a settings tab, styled like the tab's own options.
+class ModSettingsBuilder final : public mods::SettingsBuilder {
+public:
+    ModSettingsBuilder(Pane& left, Pane& right) : mLeft(left), mRight(right) {}
+
+    void add_section(const char* label_key) override {
+        mLeft.add_section(localization::get(label_key));
+    }
+
+    void add_bool(borealis::config::Var<bool>& variable, const char* label_key, const char* help_key) override {
+        ui::add_bool(mLeft, mRight, variable, localization::get(label_key), localization::get(help_key));
+    }
+
+    void add_int(borealis::config::Var<int>& variable, const char* label_key, const char* help_key, int step,
+                 const char* suffix, const char* zero_label_key) override {
+        auto props = bind(variable, { .key = localization::get(label_key), .step = step, .suffix = suffix });
+        auto& button = zero_label_key != nullptr
+                           ? static_cast<NumberButton&>(mLeft.add_child<ZeroLabelNumberButton>(
+                                 std::move(props), localization::get(zero_label_key)))
+                           : mLeft.add_child<NumberButton>(std::move(props));
+        mLeft.register_control(button, mRight,
+                               [help = localization::get(help_key)](Pane& pane) { pane.add_text(help); });
+    }
+
+    void add_choice(borealis::config::Var<int>& variable, const char* label_key, const char* help_key,
+                    const std::vector<const char*>& option_keys) override {
+        DropdownButton::Props props{ .key = localization::get(label_key) };
+        for (const char* option : option_keys) {
+            props.options.push_back({ localization::get(option) });
