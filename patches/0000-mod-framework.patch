diff --git a/pc/src/mods/mods.cpp b/pc/src/mods/mods.cpp
new file mode 100644
index 0000000..cf2ff49
--- /dev/null
+++ b/pc/src/mods/mods.cpp
@@ -0,0 +1,87 @@
+#include "acgc/mods.hpp"
+
+#include "acgc/settings.hpp"
+
+#include <aurora/binding.hpp>
+#include <borealis/ui/document.hpp>
+#include <borealis/ui/ui.hpp>
+
+#include <SDL3/SDL_keyboard.h>
+
+namespace acgc::mods {
+namespace {
+
+std::vector<Mod>& registered() {
+    // Function-local so registration from other files' static initializers is safe.
+    static std::vector<Mod> mods;
+    return mods;
+}
+
+} // namespace
+
+int register_mod(const Mod& mod) {
+    registered().push_back(mod);
+    return static_cast<int>(registered().size());
+}
+
+void create_settings(borealis::config::Registry& registry) {
+    for (const Mod& mod : registered()) {
+        if (mod.create_settings != nullptr) {
+            mod.create_settings(registry);
+        }
+    }
+}
+
+void apply_settings() {
+    for (const Mod& mod : registered()) {
+        if (mod.apply_settings != nullptr) {
+            mod.apply_settings();
+        }
+    }
+}
+
+std::vector<Hotkey> hotkeys() {
+    std::vector<Hotkey> result;
+    for (const Mod& mod : registered()) {
+        if (mod.add_hotkeys != nullptr) {
+            mod.add_hotkeys(result);
+        }
+    }
+    return result;
+}
+
+void handle_hotkey_event(const SDL_Event& event) {
+    // Keys pressed while the controls screen is waiting for a binding belong to that binding.
+    if (event.type != SDL_EVENT_KEY_DOWN || event.key.repeat || aurora::binding::capturing()) {
+        return;
+    }
+    bool pressed = false;
+    for (const Hotkey& hotkey : hotkeys()) {
+        const std::string& name = hotkey.key->get();
+        if (!name.empty() && SDL_GetScancodeFromName(name.c_str()) == event.key.scancode) {
+            hotkey.on_press();
+            pressed = true;
+        }
+    }
+    if (pressed) {
+        save_settings();
+    }
+}
+
+void build_settings(SettingsPage page, SettingsBuilder& builder) {
+    for (const Mod& mod : registered()) {
+        if (mod.build_settings != nullptr) {
+            mod.build_settings(page, builder);
+        }
+    }
+}
+
+void create_overlays() {
+    for (const Mod& mod : registered()) {
+        if (mod.create_overlay != nullptr) {
+            borealis::ui::push_document(mod.create_overlay(), true, true);
+        }
+    }
+}
+
+} // namespace acgc::mods
