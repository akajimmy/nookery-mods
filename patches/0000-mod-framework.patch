+class ZeroLabelNumberButton final : public NumberButton {
+public:
+    ZeroLabelNumberButton(Rml::Element* parent, Props props, Rml::String zeroLabel)
+        : NumberButton(parent, props), mGetValue(props.getValue), mZeroLabel(std::move(zeroLabel)) {}
+
+protected:
+    Rml::String format_value() override {
+        return mGetValue && mGetValue() == 0 ? mZeroLabel : NumberButton::format_value();
+    }
+
+private:
+    std::function<int()> mGetValue;
+    Rml::String mZeroLabel;
