diff --git a/pc/src/mods/mods.cpp b/pc/src/mods/mods.cpp
new file mode 100644
index 0000000..10bf958
--- /dev/null
+++ b/pc/src/mods/mods.cpp
@@ -0,0 +1,159 @@
+#include "acgc/mods.hpp"
+
+#include "acgc/settings.hpp"
+
+#include <aurora/binding.hpp>
+#include <borealis/ui/document.hpp>
+#include <borealis/ui/ui.hpp>
+
+#include <borealis/log.hpp>
+#include <nlohmann/json.hpp>
+
+#include <SDL3/SDL_filesystem.h>
+#include <SDL3/SDL_keyboard.h>
+
+#include <fstream>
+#include <optional>
+#include <set>
+#include <string>
+
+namespace acgc::mods {
+namespace {
+
+constexpr borealis::Log Log{ "acgc::mods" };
+
+std::vector<Mod>& registered() {
+    // Function-local so registration from other files' static initializers is safe.
+    static std::vector<Mod> mods;
+    return mods;
+}
+
+// The ids listed in mods.json next to Nookery.exe, or nullopt when there is no such file (every mod is on).
+const std::optional<std::set<std::string>>& enabled_ids() {
+    static const std::optional<std::set<std::string>> ids = []() -> std::optional<std::set<std::string>> {
+        const char* base = SDL_GetBasePath();
+        std::ifstream file(std::string(base != nullptr ? base : "") + "mods.json");
+        if (!file) {
+            return std::nullopt;
+        }
+        std::set<std::string> result;
+        try {
+            const nlohmann::json root = nlohmann::json::parse(file);
+            for (const auto& id : root.at("enabled")) {
+                result.insert(id.get<std::string>());
+            }
+        } catch (const std::exception& error) {
+            Log.warn("Could not read mods.json, so no mods are on: {}", error.what());
+        }
+        return result;
+    }();
+    return ids;
+}
+
+// The registered mods that mods.json switches on.
+const std::vector<Mod>& active() {
+    static const std::vector<Mod> mods = [] {
+        std::vector<Mod> result;
+        for (const Mod& mod : registered()) {
+            if (enabled(mod.id)) {
+                result.push_back(mod);
+                Log.info("Mod on: {}", mod.name != nullptr ? mod.name : mod.id);
+            }
+        }
+        return result;
+    }();
+    return mods;
+}
+
+} // namespace
+
+int register_mod(const Mod& mod) {
+    registered().push_back(mod);
+    return static_cast<int>(registered().size());
+}
+
+bool enabled(const char* id) {
+    const auto& ids = enabled_ids();
+    return !ids.has_value() || (id != nullptr && ids->contains(id));
+}
+
+void create_settings(borealis::config::Registry& registry) {
+    for (const Mod& mod : active()) {
+        if (mod.create_settings != nullptr) {
+            mod.create_settings(registry);
+        }
+    }
+}
+
+void apply_settings() {
+    for (const Mod& mod : active()) {
+        if (mod.apply_settings != nullptr) {
+            mod.apply_settings();
+        }
+    }
+}
+
+std::vector<Hotkey> hotkeys() {
+    std::vector<Hotkey> result;
+    for (const Mod& mod : active()) {
+        if (mod.add_hotkeys != nullptr) {
+            mod.add_hotkeys(result);
+        }
+    }
+    return result;
+}
+
+void handle_hotkey_event(const SDL_Event& event) {
+    // Keys pressed while the controls screen is waiting for a binding belong to that binding.
+    if (event.type != SDL_EVENT_KEY_DOWN || event.key.repeat || aurora::binding::capturing()) {
+        return;
+    }
+    bool pressed = false;
+    for (const Hotkey& hotkey : hotkeys()) {
+        const std::string& name = hotkey.key->get();
+        if (!name.empty() && SDL_GetScancodeFromName(name.c_str()) == event.key.scancode) {
+            hotkey.on_press();
+            pressed = true;
+        }
+    }
+    if (pressed) {
+        save_settings();
+    }
+}
+
+void build_settings(SettingsPage page, SettingsBuilder& builder) {
+    for (const Mod& mod : active()) {
+        if (mod.build_settings != nullptr) {
+            mod.build_settings(page, builder);
+        }
+    }
+}
+
+bool has_settings(SettingsPage page) {
+    // Dry run of build_settings that only notes whether anything would be added.
+    class Probe final : public SettingsBuilder {
+    public:
+        bool any = false;
+        void add_section(const char*) override {}
+        void add_bool(borealis::config::Var<bool>&, const char*, const char*) override { any = true; }
+        void add_int(borealis::config::Var<int>&, const char*, const char*, int, const char*, const char*) override {
+            any = true;
+        }
+        void add_choice(borealis::config::Var<int>&, const char*, const char*,
+                        const std::vector<const char*>&) override {
+            any = true;
+        }
+    } probe;
+    build_settings(page, probe);
+    return probe.any;
+}
+
+void create_overlays() {
+    for (const Mod& mod : active()) {
+        if (mod.create_overlay != nullptr) {
+            borealis::ui::push_document(mod.create_overlay(), true, true);
+        }
+    }
+}
+
+} // namespace acgc::mods
