 enum {
     aGKK_ACTION_SWIM,
@@ -571,7 +574,14 @@ static void aGKK_touch(ACTOR* actorx, GAME* game) {
         target_dist = search_position_distance(&actorx->world.position, &uki->actor_class.world.position);
 
         if (target_dist < aGKK_touch_distance[gyo->size_type]) {
+#ifdef TARGET_PC
+            /* Relaxed Fishing: touch_counter still holds its starting value until the first nibble. */
+            int early_bite_ok = !g_mod_fishing_no_first_bite || gyo->touch_counter != aGYO_TOUCH_COUNT_START;
+
+            if ((early_bite_ok && aGKK_random_check(4.0f) == TRUE) || DECREMENT_TIMER(gyo->touch_counter) == 0) {
+#else
             if ((aGKK_random_check(4.0f) == TRUE) || DECREMENT_TIMER(gyo->touch_counter) == 0) {
+#endif
                 if (uki->gyo_status == 2) {
                     uki->gyo_command = 2;
 
@@ -589,6 +599,11 @@ static void aGKK_touch(ACTOR* actorx, GAME* game) {
                 uki->touched_flag = TRUE;
                 gyo->work0 = (int)((aGKK_touch_count[gyo->size_type] + RANDOM2_F(30.0f)) * 2.0f);
                 actorx->speed = aGKK_back_speed[gyo->size_type] + RANDOM2_F(0.2f);
+#ifdef TARGET_PC
+                /* Relaxed Fishing: back away for longer but more slowly, so the fish ends up the same distance off. */
+                gyo->work0 = gyo->work0 * g_mod_fishing_nibble_percent / 100;
+                actorx->speed = actorx->speed * 100.0f / g_mod_fishing_nibble_percent;
+#endif
             }
         }
     }
@@ -760,6 +775,9 @@ static void aGKK_touch_init(aGYO_CTRL_ACTOR* gyo) {
 
 static void aGKK_bite_init(aGYO_CTRL_ACTOR* gyo) {    
     gyo->work0 = (int)(aGYO_bite_time[aGKK_get_uki_type()][gyoei_type[gyo->gyo_type].bite_time] * 2.0f);
+#ifdef TARGET_PC
+    gyo->work0 = gyo->work0 * g_mod_fishing_window_percent / 100;
+#endif
     gyo->swork0 = 6;
     aGKK_speed_reset((ACTOR*)gyo);
 }
