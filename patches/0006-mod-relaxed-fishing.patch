diff --git a/pc/src/mods/relaxed_fishing.cpp b/pc/src/mods/relaxed_fishing.cpp
new file mode 100644
index 0000000..c88bc1b
--- /dev/null
+++ b/pc/src/mods/relaxed_fishing.cpp
@@ -0,0 +1,103 @@
+// Relaxed Fishing: slower nibbles, a longer window to hook the fish, no bite on the first touch, and a sound when a
+// fish bites. The game side is in src/actor/ac_gyo_test.c, ac_gyo_kaseki.c for its copy of the same logic, and
+// ac_uki_move.c_inc for the sound.
+
+#include "acgc/data.hpp"
+#include "acgc/mods.hpp"
+#include "mods/relaxed_fishing.h"
+
+#include <SDL3/SDL.h>
+
+#include <filesystem>
+#include <memory>
+#include <string>
+
+extern "C" int g_mod_fishing_nibble_percent = 100;
+extern "C" int g_mod_fishing_window_percent = 100;
+extern "C" int g_mod_fishing_no_first_bite = 0;
+extern "C" int g_mod_fishing_bite_sound = 0;
+
+namespace {
+bool s_active = false;
+} // namespace
+
+extern "C" int mod_fishing_scale_frames(int frames, int percent, double dt_frames) {
+    if (!s_active) {
+        return frames;
+    }
+    // Clamped so one long or very short frame can't throw the timer off: 0.25 is 240 FPS, and 1 is 60 FPS or slower.
+    const double frame_length = dt_frames < 0.25 ? 0.25 : (dt_frames > 1.0 ? 1.0 : dt_frames);
+    return static_cast<int>(frames * (percent / 100.0) / frame_length);
+}
+
+extern "C" int mod_fishing_play_custom_bite(void) {
+    constexpr float kGain = 0.7f; // full-scale files are loud next to the game's own sounds
+    static bool s_tried = false;
+    static SDL_AudioStream* s_stream = nullptr;
+    static Uint8* s_samples = nullptr;
+    static Uint32 s_length = 0;
+
+    if (!s_tried) {
+        s_tried = true;
+        const std::filesystem::path path =
+            acgc::data::manager().active_data_path() / "custom_sounds" / "fishing_bite.wav";
+        SDL_AudioSpec spec{};
+        if (SDL_LoadWAV(path.string().c_str(), &spec, &s_samples, &s_length)) {
+            s_stream = SDL_OpenAudioDeviceStream(SDL_AUDIO_DEVICE_DEFAULT_PLAYBACK, &spec, nullptr, nullptr);
+            if (s_stream != nullptr) {
+                SDL_SetAudioStreamGain(s_stream, kGain);
+                SDL_ResumeAudioStreamDevice(s_stream);
+            }
+        }
+    }
+    if (s_stream == nullptr) {
+        return 0;
+    }
+    SDL_ClearAudioStream(s_stream);
+    return SDL_PutAudioStreamData(s_stream, s_samples, static_cast<int>(s_length)) ? 1 : 0;
+}
+
+namespace {
+using borealis::config::Var;
+using borealis::config::VarOptions;
+
+std::unique_ptr<Var<int>> s_nibble;
+std::unique_ptr<Var<int>> s_window;
+std::unique_ptr<Var<bool>> s_noFirstBite;
+std::unique_ptr<Var<int>> s_biteSound;
+
+void create_settings(borealis::config::Registry& registry) {
+    s_nibble = std::make_unique<Var<int>>(registry, "gameplay.fishingNibblePercent", 200,
+                                          VarOptions<int>{ .min = 100, .max = 400 });
+    s_window = std::make_unique<Var<int>>(registry, "gameplay.fishingBiteWindowPercent", 300,
+                                          VarOptions<int>{ .min = 100, .max = 500 });
+    s_noFirstBite = std::make_unique<Var<bool>>(registry, "gameplay.fishingNoFirstBite", true);
+    s_biteSound = std::make_unique<Var<int>>(registry, "gameplay.fishingBiteSound",
+                                             mod_FISHING_BITE_SPLASH,
+                                             VarOptions<int>{ .min = 0, .max = mod_FISHING_BITE_CUSTOM });
+}
+
+void apply_settings() {
+    s_active = true;
+    g_mod_fishing_nibble_percent = s_nibble->get();
+    g_mod_fishing_window_percent = s_window->get();
+    g_mod_fishing_no_first_bite = s_noFirstBite->get() ? 1 : 0;
+    g_mod_fishing_bite_sound = s_biteSound->get();
+}
+
+void build_settings(acgc::mods::SettingsPage page, acgc::mods::SettingsBuilder& builder) {
+    if (page == acgc::mods::SettingsPage::Gameplay) {
+        builder.add_int(*s_nibble, "mods.relaxed_fishing.nibble", "mods.relaxed_fishing.nibble_help", 25, "%");
+        builder.add_int(*s_window, "mods.relaxed_fishing.window", "mods.relaxed_fishing.window_help", 25, "%");
+        builder.add_bool(*s_noFirstBite, "mods.relaxed_fishing.no_first_bite",
+                         "mods.relaxed_fishing.no_first_bite_help");
+        builder.add_choice(*s_biteSound, "mods.relaxed_fishing.bite_sound", "mods.relaxed_fishing.bite_sound_help",
+                           { "mods.relaxed_fishing.bite_sound.off", "mods.relaxed_fishing.bite_sound.splash",
+                             "mods.relaxed_fishing.bite_sound.chomp", "mods.relaxed_fishing.bite_sound.both",
+                             "mods.relaxed_fishing.bite_sound.custom" });
+    }
+}
+} // namespace
+
+ACGC_REGISTER_MOD(relaxed_fishing, .name = "Relaxed Fishing", .create_settings = create_settings,
+                  .apply_settings = apply_settings, .build_settings = build_settings);
