diff --git a/pc/include/mods/relaxed_fishing.h b/pc/include/mods/relaxed_fishing.h
new file mode 100644
index 0000000..b1145e4
--- /dev/null
+++ b/pc/include/mods/relaxed_fishing.h
@@ -0,0 +1,34 @@
+#ifndef MODS_RELAXED_FISHING_H
+#define MODS_RELAXED_FISHING_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* The value aGTT_touch_init and aGKK_touch_init give touch_counter; it drops by one with each nibble. */
+#define aGYO_TOUCH_COUNT_START 5
+
+/* Relaxed Fishing mod. Stay at 100, 100 and 0 (the original game) unless the mod is on. */
+extern int g_mod_fishing_nibble_percent; /* time between nibbles */
+extern int g_mod_fishing_window_percent; /* time to hook the fish after it bites */
+extern int g_mod_fishing_no_first_bite;  /* the first touch is always a nibble */
+
+/* The Bite Sound setting: 0 none, or these flags. The choice order in relaxed_fishing.cpp relies on these values. */
+#define mod_FISHING_BITE_SPLASH 1
+#define mod_FISHING_BITE_CHOMP 2
+#define mod_FISHING_BITE_CUSTOM 4 /* a value of its own, not a flag */
+extern int g_mod_fishing_bite_sound;
+
+/* Plays custom_sounds/fishing_bite.wav from the game folder. Returns 0 if there's no usable file. */
+int mod_fishing_play_custom_bite(void);
+
+/* Fish timers count one per drawn frame, so at high frame rates they run out early. This scales a timer by percent and
+ * lengthens it to last the same real time as at 60 FPS. dt_frames is the frame's length in 60ths of a second. Returns
+ * frames unchanged when the mod is off. */
+int mod_fishing_scale_frames(int frames, int percent, double dt_frames);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
