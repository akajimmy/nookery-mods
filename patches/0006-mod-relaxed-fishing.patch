diff --git a/pc/src/mods/relaxed_fishing.cpp b/pc/src/mods/relaxed_fishing.cpp
new file mode 100644
index 0000000..6ee5324
--- /dev/null
+++ b/pc/src/mods/relaxed_fishing.cpp
@@ -0,0 +1,46 @@
+// Relaxed Fishing: slower nibbles, a longer window to hook the fish, and no bite on the first touch.
+// The game side is in src/actor/ac_gyo_test.c, and ac_gyo_kaseki.c for its copy of the same logic.
+
+#include "acgc/mods.hpp"
+#include "mods/relaxed_fishing.h"
+
+#include <memory>
+
+extern "C" int g_mod_fishing_nibble_percent = 100;
+extern "C" int g_mod_fishing_window_percent = 100;
+extern "C" int g_mod_fishing_no_first_bite = 0;
+
+namespace {
+using borealis::config::Var;
+using borealis::config::VarOptions;
+
+std::unique_ptr<Var<int>> s_nibble;
+std::unique_ptr<Var<int>> s_window;
+std::unique_ptr<Var<bool>> s_noFirstBite;
+
+void create_settings(borealis::config::Registry& registry) {
+    s_nibble = std::make_unique<Var<int>>(registry, "gameplay.fishingNibblePercent", 200,
+                                          VarOptions<int>{ .min = 100, .max = 400 });
+    s_window = std::make_unique<Var<int>>(registry, "gameplay.fishingBiteWindowPercent", 300,
+                                          VarOptions<int>{ .min = 100, .max = 500 });
+    s_noFirstBite = std::make_unique<Var<bool>>(registry, "gameplay.fishingNoFirstBite", true);
+}
+
+void apply_settings() {
+    g_mod_fishing_nibble_percent = s_nibble->get();
+    g_mod_fishing_window_percent = s_window->get();
+    g_mod_fishing_no_first_bite = s_noFirstBite->get() ? 1 : 0;
+}
+
+void build_settings(acgc::mods::SettingsPage page, acgc::mods::SettingsBuilder& builder) {
+    if (page == acgc::mods::SettingsPage::Gameplay) {
+        builder.add_int(*s_nibble, "mods.relaxed_fishing.nibble", "mods.relaxed_fishing.nibble_help", 25, "%");
+        builder.add_int(*s_window, "mods.relaxed_fishing.window", "mods.relaxed_fishing.window_help", 25, "%");
+        builder.add_bool(*s_noFirstBite, "mods.relaxed_fishing.no_first_bite",
+                         "mods.relaxed_fishing.no_first_bite_help");
+    }
+}
+} // namespace
+
+ACGC_REGISTER_MOD(relaxed_fishing, .name = "Relaxed Fishing", .create_settings = create_settings,
+                  .apply_settings = apply_settings, .build_settings = build_settings);
