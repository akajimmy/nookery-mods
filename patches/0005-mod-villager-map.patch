+#ifdef TARGET_PC
+/* Villager Map mod. Colours are { r, g, b }, one per kind of mark. */
+enum { mMP_MARK_INDOORS, mMP_MARK_OUTDOORS, mMP_MARK_REGULAR, mMP_MARK_TRAVELLER, mMP_MARK_CAMPER, mMP_MARK_NUM };
+static u8 mMP_villager_color[mMP_MARK_NUM][3] = {
+    { 255, 220, 0 },   /* villager indoors: yellow */
+    { 80, 230, 80 },   /* villager outdoors: green */
+    { 70, 150, 255 },  /* town regular: blue */
+    { 255, 110, 200 }, /* one-day traveller: pink */
+    { 240, 50, 40 },   /* visiting villager (the summer camper): red */
+};
+
+/* Characters who aren't residents, and who appear around town rather than staying in one building. Several actor
+ * names can be the same person (Tortimer has one per event); person groups them so each is shown once. Redd, Katrina
+ * and Gracie stay in a tent or car, and the event list records that structure, so it stands for them. Copper only
+ * leaves his post to lead the morning exercise, as SP_NPC_EV_TAISOU_0, so his post (SP_NPC_POLICE) isn't listed. */
+static const struct {
+    mActor_name_t name;
+    u8 person;
+} mMP_visitor_names[] = {
+    /* Town regulars */
+    { SP_NPC_EV_SONCHO, 0 },     { SP_NPC_EV_SONCHO2, 0 },   { SP_NPC_SONCHO, 0 },        { SP_NPC_SONCHO_D078, 0 },
+    { SP_NPC_SONCHO_D079, 0 },   { SP_NPC_EV_SPEECH_SONCHO, 0 },                         /* Tortimer */
+    { SP_NPC_ANGLER, 1 },                                                                 /* Chip */
+    { SP_NPC_TOTAKEKE, 2 },                                                               /* K.K. Slider */
+    { SP_NPC_POST_MAN, 3 },                                                               /* Pete */
+    { SP_NPC_EV_TAISOU_0, 4 },                                                            /* Copper */
+    /* One-day travellers */
+    { SP_NPC_BROKER, 5 },        { SP_NPC_EV_BROKER2, 5 },   { SP_NPC_EV_YOMISE, 5 },    { SP_NPC_EV_YOMISE2, 5 },
+    { BROKER_TENT, 5 },                                                                   /* Redd */
+    { SP_NPC_GYPSY, 6 },         { SP_NPC_EV_MIKO, 6 },      { FORTUNE_TENT, 6 },         /* Katrina */
+    { SP_NPC_CARPETPEDDLER, 7 },                                                          /* Saharah */
+    { SP_NPC_ARTIST, 8 },                                                                 /* Wendell */
+    { SP_NPC_SANTA, 9 },                                                                  /* Jingle */
+    { SP_NPC_DESIGNER, 10 },     { DESIGNER_CAR, 10 },                                    /* Gracie */
+    { SP_NPC_KABUPEDDLER, 11 },                                                           /* Joan */
+    { SP_NPC_HALLOWEEN, 12 },                                                             /* Jack */
+    { SP_NPC_EV_DOZAEMON, 13 },                                                           /* Gulliver */
+    { SP_NPC_EV_GHOST, 14 },                                                              /* Wisp */
+    { SP_NPC_MASK_CAT, 15 },     { SP_NPC_MASK_CAT2, 15 },                                /* Blanca */
+    { SP_NPC_TURKEY, 16 },                                                                /* Franklin */
+    { SP_NPC_HEM, 17 },                                                                   /* Farley */
+    /* Visiting villager: the summer camper, a villager from elsewhere staying in a tent */
+    { SP_NPC_EV_SUMMERCAMP_0, 18 }, { TENT, 18 },
+};
+#define mMP_PERSON_REGULAR_END 5 /* persons below this are town regulars */
+#define mMP_PERSON_CAMPER 18
+#define mMP_PERSON_NUM 19
+#define mMP_VISITOR_MAX 12
+
+static int mMP_visitor_mark(int person) {
+    if (person == mMP_PERSON_CAMPER) {
+        return mMP_MARK_CAMPER;
+    }
+    return person < mMP_PERSON_REGULAR_END ? mMP_MARK_REGULAR : mMP_MARK_TRAVELLER;
+}
+
+typedef struct {
+    mActor_name_t name;
+    u8 person;
+    f32 acre_x;
+    f32 acre_z;
+} mMP_visitor_c;
+
+static mMP_visitor_c mMP_visitors[mMP_VISITOR_MAX];
+static int mMP_visitor_num = 0;
+static u32 mMP_visitor_logged = 0;
+
+/* The dots are a textured square like the map's house icons: a 64x64 circle whose alpha is the circle's coverage of
+ * each texel, so the edge is smooth once filtered. The colour comes from the primitive colour. The texture is GX IA8
+ * (G_IM_FMT_IA, 16-bit): 4x4-texel tiles, two bytes per texel. Both bytes hold the coverage, so it reads the same
+ * whichever byte is alpha. */
+#define mMP_DOT_TEX_SIZE 64
+static ATTRIBUTE_ALIGN(32) u8 mMP_dot_tex[mMP_DOT_TEX_SIZE * mMP_DOT_TEX_SIZE * 2];
+
+static void mMP_make_dot_tex(void) {
+    static int made = FALSE;
+    const f32 centre = mMP_DOT_TEX_SIZE * 0.5f;
+    const f32 radius = centre - 1.0f;
+    int x;
+    int y;
+
+    if (made) {
+        return;
+    }
+    made = TRUE;
+
+    for (y = 0; y < mMP_DOT_TEX_SIZE; y++) {
+        for (x = 0; x < mMP_DOT_TEX_SIZE; x++) {
+            /* Coverage from a 4x4 grid of samples in the texel. */
+            int inside = 0;
+            int sx;
+            int sy;
+            int tile = (y / 4) * (mMP_DOT_TEX_SIZE / 4) + (x / 4);
+            int ofs = (tile * 16 + (y % 4) * 4 + (x % 4)) * 2;
+            u8 coverage;
+
+            for (sy = 0; sy < 4; sy++) {
+                for (sx = 0; sx < 4; sx++) {
+                    f32 dx = x + (sx + 0.5f) / 4.0f - centre;
+                    f32 dy = y + (sy + 0.5f) / 4.0f - centre;
+
+                    inside += dx * dx + dy * dy <= radius * radius;
+                }
+            }
+            coverage = (u8)((inside * 255) / 16);
+            mMP_dot_tex[ofs] = coverage;
+            mMP_dot_tex[ofs + 1] = coverage;
+        }
+    }
+}
+
+/* A square of half-size 100 with the whole texture on it. UVs are texels * 32. */
+#define mMP_DOT_UV (mMP_DOT_TEX_SIZE * 32)
+static Vtx mMP_villager_dot_v[] = {
+    { { { -100, 100, 0 }, 0, { 0, 0 }, { 255, 255, 255, 255 } } },
+    { { { -100, -100, 0 }, 0, { 0, mMP_DOT_UV }, { 255, 255, 255, 255 } } },
+    { { { 100, 100, 0 }, 0, { mMP_DOT_UV, 0 }, { 255, 255, 255, 255 } } },
+    { { { 100, -100, 0 }, 0, { mMP_DOT_UV, mMP_DOT_UV }, { 255, 255, 255, 255 } } },
+};
+
+static Gfx mMP_villager_disc_model[] = {
+    gsDPSetTextureImage_Dolphin(G_IM_FMT_IA, G_IM_SIZ_16b, mMP_DOT_TEX_SIZE, mMP_DOT_TEX_SIZE, mMP_dot_tex),
+    gsDPSetTile_Dolphin(G_DOLPHIN_TLUT_DEFAULT_MODE, 0, 0, GX_CLAMP, GX_CLAMP, 0, 0),
+    gsSPVertex(mMP_villager_dot_v, 4, 0),
+    gsSPNTrianglesInit_5b(2, 0, 1, 2, 1, 3, 2, 0, 0, 0),
+    gsSPEndDisplayList(),
+};
+
+/* Finds where villager idx is now, in acres from the top left of the map. Near the player the villager is a live
+ * actor; elsewhere the set manager walks the villager's npclist position between acres. Returns FALSE if there is no
+ * villager in that slot or the position is off the map. */
+static int mMP_villager_position(GAME* game, int idx, f32* acre_x, f32* acre_z, int* outdoors) {
+    Animal_c* animal = &Save_Get(animals[idx]);
+    mNpc_NpcList_c* list = Common_GetPointer(npclist[idx]);
+    ACTOR* actor = NULL;
+    xyz_t pos;
+
+    if (mNpc_CheckFreeAnimalInfo(animal) == TRUE) {
+        return FALSE;
+    }
+
+    /* Indoors, a villager's actor is in room coordinates, which mean nothing on the map. */
+    if (mFI_GET_TYPE(mFI_GetFieldId()) == mFI_FIELD_FG) {
+        actor = Actor_info_fgName_search(&((GAME_PLAY*)game)->actor_info, list->name, ACTOR_PART_NPC);
+    }
+
+    if (actor != NULL) {
+        pos = actor->world.position;
+        *outdoors = TRUE;
+    } else if (animal->is_home) {
+        pos = list->house_position;
+        *outdoors = FALSE;
+    } else {
+        pos = list->position;
+        *outdoors = TRUE;
+    }
+
+    /* Block 0 is the border around the map. */
+    *acre_x = pos.x / mFI_BK_WORLDSIZE_X_F - 1.0f;
+    *acre_z = pos.z / mFI_BK_WORLDSIZE_Z_F - 1.0f;
+    return *acre_x >= 0.0f && *acre_x < FG_BLOCK_X_NUM && *acre_z >= 0.0f && *acre_z < FG_BLOCK_Z_NUM;
+}
+
+static int mMP_visitor_person(mActor_name_t name) {
+    int i;
+
+    for (i = 0; i < ARRAY_COUNT(mMP_visitor_names); i++) {
+        if (mMP_visitor_names[i].name == name) {
+            return mMP_visitor_names[i].person;
+        }
+    }
+    return -1;
+}
+
+/* Adds a visitor at a world position, unless that person is already on the list (the first source wins). */
+static void mMP_add_visitor(mActor_name_t name, const xyz_t* pos) {
+    int person = mMP_visitor_person(name);
+    f32 acre_x;
+    f32 acre_z;
+    int i;
+
+    if (person < 0 || mMP_visitor_num >= mMP_VISITOR_MAX) {
+        return;
+    }
+    for (i = 0; i < mMP_visitor_num; i++) {
+        if (mMP_visitors[i].person == person) {
+            return;
+        }
+    }
+
+    acre_x = pos->x / mFI_BK_WORLDSIZE_X_F - 1.0f;
+    acre_z = pos->z / mFI_BK_WORLDSIZE_Z_F - 1.0f;
+    if (acre_x < 0.0f || acre_x >= FG_BLOCK_X_NUM || acre_z < 0.0f || acre_z >= FG_BLOCK_Z_NUM) {
+        return;
+    }
+
+    mMP_visitors[mMP_visitor_num].name = name;
+    mMP_visitors[mMP_visitor_num].person = person;
+    mMP_visitors[mMP_visitor_num].acre_x = acre_x;
+    mMP_visitors[mMP_visitor_num].acre_z = acre_z;
+    mMP_visitor_num++;
+}
+
+static void mMP_add_visitor_at_unit(mActor_name_t name, int bx, int bz, int ut_x, int ut_z) {
+    xyz_t pos;
+
+    if (mMP_visitor_person(name) >= 0 && mFI_BlockCheck(bx, bz)) {
+        mFI_BkandUtNum2CenterWpos(&pos, bx, bz, ut_x, ut_z);
+        mMP_add_visitor(name, &pos);
+    }
+}
+
+/* Finds the visitors in town, from three places, best first:
+ *  1. live actors, which exist near the player and have exact positions;
+ *  2. the event places (Common event_common), where events and visits put their character, e.g. Chip at the fishing
+ *     tourney, K.K. on Saturday night, Katrina's tent;
+ *  3. each acre's move-actor list, the characters to spawn when the player walks into that acre. */
+static void mMP_collect_visitors(GAME* game) {
+    mEv_common_data_c* ev_common = Common_GetPointer(event_common);
+    int outdoors = mFI_GET_TYPE(mFI_GetFieldId()) == mFI_FIELD_FG;
+    u32 signature = 1;
+    int i;
+
+    mMP_visitor_num = 0;
+
+    if (outdoors) {
+        ACTOR* actor;
+
+        for (actor = ((GAME_PLAY*)game)->actor_info.list[ACTOR_PART_NPC].actor; actor != NULL;
+             actor = actor->next_actor) {
+            mMP_add_visitor(actor->npc_id, &actor->world.position);
+        }
+    }
+
+    for (i = 0; i < mEv_PLACE_NUM; i++) {
+        mEv_place_c* place = &ev_common->place[i];
+
+        if ((ev_common->place_use_bitfield & (1 << i)) != 0 && mEv_check_status(place->info.type, mEv_STATUS_ACTIVE)) {
+            mMP_add_visitor_at_unit(place->data.actor_name, place->data.block.x, place->data.block.z,
+                                    place->data.unit.x, place->data.unit.z);
+        }
+    }
+
+    /* The acre lists belong to the town field, so they're only read while the player is in it. */
+    if (outdoors && g_fdinfo != NULL) {
+        int bx;
+        int bz;
+
+        for (bz = 0; bz < BLOCK_Z_NUM; bz++) {
+            for (bx = 0; bx < BLOCK_X_NUM; bx++) {
+                if (mFI_BlockCheck(bx, bz)) {
+                    mFM_move_actor_c* list = g_fdinfo->block_info[mFI_GetBlockNum(bx, bz)].fg_info.move_actors;
+
+                    for (i = 0; i < mFM_MOVE_ACTOR_NUM; i++) {
+                        if (list[i].name_id != EMPTY_NO) {
+                            mMP_add_visitor_at_unit(list[i].name_id, bx, bz, list[i].ut_x, list[i].ut_z);
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    /* Log the list whenever it changes, so a wrong or missing mark can be traced to its source. */
+    for (i = 0; i < mMP_visitor_num; i++) {
+        signature = signature * 31 + mMP_visitors[i].name * 7 + (u32)(mMP_visitors[i].acre_x * 4.0f) * 131 +
+                    (u32)(mMP_visitors[i].acre_z * 4.0f);
+    }
+    if (signature != mMP_visitor_logged) {
+        mMP_visitor_logged = signature;
+        borealis_log_printf(BOREALIS_LOG_INFO, "villager_map", "%d visitor(s) on the map", mMP_visitor_num);
+        for (i = 0; i < mMP_visitor_num; i++) {
+            borealis_log_printf(BOREALIS_LOG_INFO, "villager_map", "  %04X at acre %.2f, %.2f", mMP_visitors[i].name,
+                                mMP_visitors[i].acre_x, mMP_visitors[i].acre_z);
+        }
+        for (i = 0; i < mEv_PLACE_NUM; i++) {
+            if ((ev_common->place_use_bitfield & (1 << i)) != 0) {
+                mEv_place_c* place = &ev_common->place[i];
+
+                borealis_log_printf(BOREALIS_LOG_INFO, "villager_map",
+                                    "  event place %d: event %d id %d, actor %04X, block %d,%d unit %d,%d, %s", i,
+                                    place->info.type, place->info.id, place->data.actor_name, place->data.block.x,
+                                    place->data.block.z, place->data.unit.x, place->data.unit.z,
+                                    mEv_check_status(place->info.type, mEv_STATUS_ACTIVE) ? "active" : "inactive");
+            }
+        }
+    }
+}
+
+/* A visitor's name, loaded once per person. The summer camper is a different villager each time, so their name comes
+ * from the villager the camper stands in for, every time. */
+static u8* mMP_visitor_name(const mMP_visitor_c* visitor) {
+    static u8 names[mMP_PERSON_NUM][ANIMAL_NAME_LEN];
+    static u8 loaded[mMP_PERSON_NUM];
+
+    if (visitor->person == mMP_PERSON_CAMPER) {
+        mNpc_MaskNpc_c* camper = mNpc_GetSameMaskNpc(SP_NPC_EV_SUMMERCAMP_0);
+
+        mNpc_GetActorWorldName(names[visitor->person], camper != NULL ? camper->npc_id : SP_NPC_EV_SUMMERCAMP_0);
+        return names[visitor->person];
+    }
+    if (!loaded[visitor->person]) {
+        mNpc_GetActorWorldName(names[visitor->person], visitor->name);
+        loaded[visitor->person] = TRUE;
+    }
+    return names[visitor->person];
+}
+
+static Gfx* mMP_villager_disc(Gfx* gfx, GRAPH* graph, f32 x, f32 y, f32 radius, u8 r, u8 g, u8 b) {
+    Matrix_scale(16.0f, 16.0f, 1.0f, MTX_LOAD);
+    Matrix_translate(x, y, 140.0f, MTX_MULT);
+    Matrix_scale(radius / 100.0f, radius / 100.0f, 1.0f, MTX_MULT);
+
+    gSPMatrix(gfx++, _Matrix_to_Mtx_new(graph), G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
+    gDPSetPrimColor(gfx++, 0, 255, r, g, b, 255);
+    gSPDisplayList(gfx++, mMP_villager_disc_model);
+    return gfx;
+}
+
+/* A coloured dot with a dark rim, so it shows on any map colour. */
+static Gfx* mMP_villager_dot(Gfx* gfx, GRAPH* graph, f32 x, f32 y, int mark) {
+    u8* col = mMP_villager_color[mark];
+
+    gfx = mMP_villager_disc(gfx, graph, x, y, 2.4f, 40, 30, 30);
+    return mMP_villager_disc(gfx, graph, x, y, 1.7f, col[0], col[1], col[2]);
+}
+
+static void mMP_set_villager_dl(GAME* game, GRAPH* graph, f32 pos_x, f32 pos_y) {
+    f32 left = pos_x + mMP_MAP_OFFSET_X - (0.5f * mMP_BLOCK_SIZE_F);
+    f32 top = pos_y + mMP_MAP_OFFSET_Y + (0.5f * mMP_BLOCK_SIZE_F);
+    f32 acre_x;
+    f32 acre_z;
+    int outdoors;
+    int i;
+    Gfx* gfx;
+
+    OPEN_DISP(graph);
+
+    mMP_make_dot_tex();
+    gfx = NOW_POLY_OPA_DISP;
+    gSPDisplayList(gfx++, kan_win_mode);
+    /* Colour from the primitive colour, alpha from the texture, blended by kan_win_mode like the house icons. */
+    gDPSetCombineLERP(gfx++, 0, 0, 0, PRIMITIVE, TEXEL0, 0, PRIMITIVE, 0, 0, 0, 0, PRIMITIVE, TEXEL0, 0, PRIMITIVE, 0);
+
+    for (i = 0; i < ANIMAL_NUM_MAX; i++) {
+        if (mMP_villager_position(game, i, &acre_x, &acre_z, &outdoors)) {
+            f32 x = left + acre_x * mMP_BLOCK_SIZE_F;
+            f32 y = top - acre_z * mMP_BLOCK_SIZE_F;
+
+            gfx = mMP_villager_dot(gfx, graph, x, y, outdoors ? mMP_MARK_OUTDOORS : mMP_MARK_INDOORS);
+        }
+    }
+
+    mMP_collect_visitors(game);
+    for (i = 0; i < mMP_visitor_num; i++) {
+        f32 x = left + mMP_visitors[i].acre_x * mMP_BLOCK_SIZE_F;
+        f32 y = top - mMP_visitors[i].acre_z * mMP_BLOCK_SIZE_F;
+
+        gfx = mMP_villager_dot(gfx, graph, x, y, mMP_visitor_mark(mMP_visitors[i].person));
+    }
+
+    SET_POLY_OPA_DISP(gfx);
+    CLOSE_DISP(graph);
+}
+
+/* Names whoever is in the selected acre, over the map at that acre. */
+static void mMP_set_villager_names(GAME* game, mMP_Ovl_c* map_ovl, f32 pos_x, f32 pos_y) {
+    f32 x = 160.0f + pos_x + mMP_MAP_OFFSET_X - (0.5f * mMP_BLOCK_SIZE_F) + map_ovl->sel_bx * mMP_BLOCK_SIZE_F + 1.0f;
+    f32 y = 120.0f - (pos_y + mMP_MAP_OFFSET_Y + (0.5f * mMP_BLOCK_SIZE_F)) + map_ovl->sel_bz * mMP_BLOCK_SIZE_F + 1.0f;
+    f32 acre_x;
+    f32 acre_z;
+    int outdoors;
+    int i;
+
+    for (i = 0; i < ANIMAL_NUM_MAX; i++) {
+        if (mMP_villager_position(game, i, &acre_x, &acre_z, &outdoors) && (int)acre_x == map_ovl->sel_bx &&
+            (int)acre_z == map_ovl->sel_bz) {
+            u8* name = map_ovl->animal_info[i].name;
+            u8* col = mMP_villager_color[outdoors ? mMP_MARK_OUTDOORS : mMP_MARK_INDOORS];
+
