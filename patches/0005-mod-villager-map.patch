+// Villager Map: shows where each villager is right now on the town map, and names whoever is in the selected acre.
+// The game side is in src/game/m_map_ovl.c.
+
+#include "acgc/mods.hpp"
+#include "mods/villager_map.h"
+
+#include <memory>
+
+extern "C" int g_mod_villager_map = 0;
+
+namespace {
+using borealis::config::Var;
+
+std::unique_ptr<Var<bool>> s_show;
+
+void create_settings(borealis::config::Registry& registry) {
+    s_show = std::make_unique<Var<bool>>(registry, "gameplay.villagerMap", true);
+}
+
+void apply_settings() {
+    g_mod_villager_map = s_show->get() ? 1 : 0;
+}
+
+void build_settings(acgc::mods::SettingsPage page, acgc::mods::SettingsBuilder& builder) {
+    if (page == acgc::mods::SettingsPage::Gameplay) {
+        builder.add_bool(*s_show, "mods.villager_map.label", "mods.villager_map.help");
+    }
+}
+} // namespace
+
+ACGC_REGISTER_MOD(villager_map, .name = "Villager Map", .create_settings = create_settings,
+                  .apply_settings = apply_settings, .build_settings = build_settings);
