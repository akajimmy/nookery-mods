     PC_DIAG(5, "play_main: enter scene=%d frame=%d\n", play->scene_id, play->game_frame);
+#ifdef TARGET_PC
+    pc_save_quit_update(play);
+#endif
     game->doing_point = 0;
     game->doing_point_specific = 0x6E;
     fqrand();
