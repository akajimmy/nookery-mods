@@ -0,0 +1,42 @@
+// Save and Quit: a hotkey that opens the gyroid's save screen while you're outdoors in your own town, and an option
+// to close the game after saving instead of going back to the title. The game side is in src/game/m_play.c.
+
+#include "acgc/mods.hpp"
+#include "mods/save_quit.h"
+
+#include <memory>
+#include <string>
+
+extern "C" int g_mod_save_quit_request = 0;
+extern "C" int g_mod_save_quit_to_desktop = 0;
+extern "C" int g_mod_save_quit_saved = 0;
+
+namespace {
+using borealis::config::Var;
+
+std::unique_ptr<Var<std::string>> s_key;
+std::unique_ptr<Var<bool>> s_toDesktop;
+
+void create_settings(borealis::config::Registry& registry) {
+    // F5: unbound in Nookery's default keyboard layout, and the usual quick-save key in PC games.
+    s_key = std::make_unique<Var<std::string>>(registry, "input.saveQuitKey", std::string("F5"));
+    s_toDesktop = std::make_unique<Var<bool>>(registry, "gameplay.saveQuitToDesktop", false);
+}
+
+void apply_settings() {
+    g_mod_save_quit_to_desktop = s_toDesktop->get() ? 1 : 0;
+}
+
+void add_hotkeys(std::vector<acgc::mods::Hotkey>& hotkeys) {
+    hotkeys.push_back({ "mods.save_quit.hotkey", s_key.get(), [] { g_mod_save_quit_request = 1; } });
+}
+
+void build_settings(acgc::mods::SettingsPage page, acgc::mods::SettingsBuilder& builder) {
+    if (page == acgc::mods::SettingsPage::Gameplay) {
+        builder.add_bool(*s_toDesktop, "mods.save_quit.to_desktop", "mods.save_quit.to_desktop_help");
+    }
+}
+} // namespace
+
+ACGC_REGISTER_MOD(save_quit, .name = "Save and Quit", .create_settings = create_settings,
+                  .apply_settings = apply_settings, .add_hotkeys = add_hotkeys, .build_settings = build_settings);
