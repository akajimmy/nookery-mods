+#ifdef TARGET_PC
+/* Save and Quit hotkey: does what the house door does after the gyroid's "save" choice, without walking home. */
+static int pc_save_quit_allowed(GAME_PLAY* play) {
+    int scene = Save_Get(scene_no);
+    int main_index;
+
+    /* Outdoors in the town only; buildings are blocked to be safe. */
+    if (mEv_CheckTitleDemo() != mEv_TITLEDEMO_NONE || mEv_CheckFirstIntro() || mLd_PlayerManKindCheck() ||
+        mFI_CheckInIsland() || Common_Get(reset_flag) || mFI_GET_TYPE(mFI_GetFieldId()) != mFI_FIELD_FG) {
+        return FALSE;
+    }
+    switch (scene) {
+        case SCENE_START_DEMO:
+        case SCENE_START_DEMO2:
+        case SCENE_START_DEMO3:
+        case SCENE_PLAYERSELECT:
+        case SCENE_PLAYERSELECT_2:
+        case SCENE_PLAYERSELECT_3:
+        case SCENE_PLAYERSELECT_SAVE:
+        case SCENE_TITLE_DEMO:
+            return FALSE;
+    }
+    if (play->fb_wipe_mode != WIPE_MODE_NONE || play->submenu.open_flag || mDemo_CheckDemo() ||
+        !mMsg_CHECK_MAINHIDE()) {
+        return FALSE;
+    }
+    /* Only while the player is standing, walking or running, as when they'd walk up to the gyroid. */
+    main_index = mPlib_get_player_actor_main_index((GAME*)play);
+    return main_index >= mPlayer_INDEX_WAIT && main_index <= mPlayer_INDEX_DASH;
+}
+
+/* Same check and flag as the gyroid's aHNW_set_save_permission: the player must own their house. */
+static int pc_save_quit_set_permission(void) {
+    u32 player_no = Common_Get(player_no);
+
+    if (player_no < PLAYER_NUM) {
+        mHm_hs_c* house = Save_GetPointer(homes[mHS_get_arrange_idx(player_no)]);
+        PersonalID_c* pid = &Save_Get(private_data[player_no]).player_ID;
+
+        if (mPr_NullCheckPersonalID(pid) != TRUE && mPr_CheckCmpPersonalID(pid, &house->ownerID) == TRUE) {
+            house->flags.has_saved = TRUE;
+            return TRUE;
+        }
+    }
+    return FALSE;
+}
+
+static void pc_save_quit_update(GAME_PLAY* play) {
+    /* Same door data the house uses to enter the save scene (ac_my_house_move.c_inc). */
+    static Door_data_c door_data = {
+        SCENE_PLAYERSELECT_SAVE, mSc_DIRECT_NORTH, 0, 0, { 100, 0, 120 }, EMPTY_NO, 1, { 0, 0, 0 },
+    };
+
+    if (!g_mod_save_quit_request) {
+        return;
+    }
+    g_mod_save_quit_request = 0;
+    if (!pc_save_quit_allowed(play) || !pc_save_quit_set_permission()) {
+        return;
+    }
+    mBGMPsComp_scene_mode(13);
+    mBGMPsComp_make_ps_wipe(0x249);
+    if (goto_other_scene(play, &door_data, 1) == 1) {
+        Common_Get(transition).wipe_type = 3;
+        play->fb_fade_type = FADE_TYPE_DEMO;
+    }
+}
+#endif
