 #endif
 
 /**
@@ -95,6 +96,31 @@ static int mCon_mouse_gameplay_allowed(void) {
          mMsg_CHECK_MAINHIDE();
 }
 
+static int mCon_mouse_ground_offset(GAME_PLAY* play, xyz_t* position, xyz_t* offset);
+
+/* Right-Click Aim mod: turn a free-standing player to face the spot under the cursor, so the A press that follows
+ * interacts with what was clicked. */
+static void mCon_mouse_face_cursor(GAME_PLAY* play) {
+  PLAYER_ACTOR* player = get_player_actor_withoutCheck(play);
+  xyz_t offset;
+  s16 angle;
+
+  if (player == NULL || mDemo_CheckDemo() || player->now_main_index < mPlayer_INDEX_WAIT ||
+      player->now_main_index > mPlayer_INDEX_DASH) {
+    return;
+  }
+  if (!mCon_mouse_ground_offset(play, &player->actor_class.world.position, &offset)) {
+    return;
+  }
+  /* Clicking on the player themself keeps their current facing. */
+  if (offset.x * offset.x + offset.z * offset.z < 4.0f * 4.0f) {
+    return;
+  }
+  angle = atans_table(offset.z, offset.x);
+  player->actor_class.shape_info.rotation.y = angle;
+  player->actor_class.world.angle.y = angle;
+}
+
 static void mCon_update_mouse_action(void) {
   GAME_PLAY* play = (GAME_PLAY*)gamePT;
   PLAYER_ACTOR* player;
@@ -108,6 +134,9 @@ static void mCon_update_mouse_action(void) {
 
   const GamePointerFrame* pointer = acgc_pointer_frame();
   mouse_action_triggered = (pointer->pressed & GAME_POINTER_RIGHT) != 0;
+  if (mouse_action_triggered && g_mod_mouse.right_click_aim) {
+    mCon_mouse_face_cursor(play);
+  }
   mouse_action_held = mouse_action_triggered || (mouse_action_held && (pointer->held & GAME_POINTER_RIGHT));
 
   player = get_player_actor_withoutCheck(play);
