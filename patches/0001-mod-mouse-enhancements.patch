@@ -0,0 +1,36 @@
+#ifndef MODS_MOUSE_ENHANCEMENTS_H
+#define MODS_MOUSE_ENHANCEMENTS_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Mouse Enhancements mod. The game reads these each frame; mod_mouse_select_context fills in the glove's look for
+ * the current context (Enhanced or Vanilla style, depending on the settings and whether a menu is open). With the
+ * mod off, every value matches the original game. */
+typedef struct {
+    int enabled;         /* 1 = the mod is switched on; also turns on its blink and system-key fixes */
+    int size;            /* Glove height in 480-line game units (original 64) */
+    int flip_x;          /* 1 = mirror left-right */
+    int flip_y;          /* 1 = mirror top-bottom */
+    int rotation;        /* Clockwise degrees, applied after flipping, about the click point */
+    int shift_x;         /* Moves the click point right within the glove image, percent of its size */
+    int shift_y;         /* Moves the click point down within the glove image, percent of its size */
+    int turn_over;       /* 1 = render the 3D glove turned over, showing its other side */
+    int hide_seconds;    /* Hide the glove after this many idle seconds, 0 = never (original 5) */
+    int click_tilt;      /* Degrees a turned-over glove tilts on click; negative tilts the other way */
+    int click_speed;     /* Click animation speed, percent (original 100) */
+    int in_menus;        /* 1 = draw this glove instead of the menu hand while pointing with the mouse in menus */
+    int right_click_aim; /* 1 = right-click turns the player toward the cursor before interacting */
+} ModMouseEnhancements;
+
+extern ModMouseEnhancements g_mod_mouse;
+
+/* Choose the glove's look for this frame: in_menu = 1 while a menu is open. */
+void mod_mouse_select_context(int in_menu);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
