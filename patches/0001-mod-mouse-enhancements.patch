diff --git a/pc/src/mods/mouse_enhancements.cpp b/pc/src/mods/mouse_enhancements.cpp
new file mode 100644
index 0000000..7286d4e
--- /dev/null
+++ b/pc/src/mods/mouse_enhancements.cpp
@@ -0,0 +1,122 @@
+// Mouse Enhancements: an Enhanced cursor style (the back of a half-size glove pointing top-left, with a tilt click),
+// where to use it (out of menus, in menus, everywhere), how long before the cursor hides, right-click aiming, and two
+// fixes (the glove blinking while scenery shaders compile, and system keys hiding it).
+// The game side is in pc/src/aurora_mouse_cursor.cpp, pc/src/acgc_game_pointer.cpp, src/game/m_hand_ovl.c and
+// src/game/m_controller.c.
+
+#include "acgc/mods.hpp"
+#include "mods/mouse_enhancements.h"
+
+#include "aurora_mouse_cursor.h"
+
+#include <memory>
+
+namespace {
+using borealis::config::Var;
+using borealis::config::VarOptions;
+
+enum Style { kStyleVanilla, kStyleEnhanced };
+enum Scope { kScopeOutOfMenus, kScopeInMenus, kScopeEverywhere };
+
+// The glove look for each style. Enhanced shows the back of a right hand at half size, pointing top-left with the
+// click point on the fingertip (measured at 2560x1440), and tilts 35 degrees into the world on click at 250% speed.
+struct Look {
+    int size, flip_x, flip_y, rotation, shift_x, shift_y, turn_over, click_tilt, click_speed;
+};
+constexpr Look kVanilla = { 64, 0, 0, 0, 0, 0, 0, -45, 100 };
+constexpr Look kEnhanced = { 32, 0, 0, -6, 4, -82, 1, -35, 250 };
+
+struct Settings {
+    std::unique_ptr<Var<int>> style, scope, hideSeconds;
+    std::unique_ptr<Var<bool>> rightClickAim;
+} s;
+int s_style = kStyleEnhanced;
+int s_scope = kScopeEverywhere;
+int s_inMenu = 0;
+
+void create_settings(borealis::config::Registry& registry) {
+    s.style = std::make_unique<Var<int>>(registry, "input.cursorStyle", static_cast<int>(kStyleEnhanced),
+                                         VarOptions<int>{ .min = kStyleVanilla, .max = kStyleEnhanced });
+    s.scope = std::make_unique<Var<int>>(registry, "input.cursorScope", static_cast<int>(kScopeEverywhere),
+                                         VarOptions<int>{ .min = kScopeOutOfMenus, .max = kScopeEverywhere });
+    s.hideSeconds =
+        std::make_unique<Var<int>>(registry, "input.cursorHideSeconds", 0, VarOptions<int>{ .min = 0, .max = 99 });
+    s.rightClickAim = std::make_unique<Var<bool>>(registry, "input.rightClickFaceCursor", true);
+}
+
+void apply_settings();
+
+void build_settings(acgc::mods::SettingsPage page, acgc::mods::SettingsBuilder& builder) {
+    if (page != acgc::mods::SettingsPage::Mouse) {
+        return;
+    }
+    builder.add_section("mods.mouse.section");
+    builder.add_choice(*s.style, "mods.mouse.style", "mods.mouse.style_help",
+                       { "mods.mouse.style.vanilla", "mods.mouse.style.enhanced" });
+    builder.add_choice(*s.scope, "mods.mouse.scope", "mods.mouse.scope_help",
+                       { "mods.mouse.scope.out_of_menus", "mods.mouse.scope.in_menus",
+                         "mods.mouse.scope.everywhere" });
+    builder.add_int(*s.hideSeconds, "mods.mouse.hide_seconds", "mods.mouse.hide_seconds_help", 1, " s",
+                    "mods.mouse.hide_seconds.never");
+    builder.add_bool(*s.rightClickAim, "mods.mouse.right_click_aim", "mods.mouse.right_click_aim_help");
+}
+} // namespace
+
+extern "C" ModMouseEnhancements g_mod_mouse = {
+    .enabled = 0,
+    .size = kVanilla.size,
+    .flip_x = kVanilla.flip_x,
+    .flip_y = kVanilla.flip_y,
+    .rotation = kVanilla.rotation,
+    .shift_x = kVanilla.shift_x,
+    .shift_y = kVanilla.shift_y,
+    .turn_over = kVanilla.turn_over,
+    .hide_seconds = 5,
+    .click_tilt = kVanilla.click_tilt,
+    .click_speed = kVanilla.click_speed,
+    .in_menus = 0,
+    .right_click_aim = 0,
+};
+
+extern "C" void mod_mouse_select_context(int in_menu) {
+    s_inMenu = in_menu;
+    if (!g_mod_mouse.enabled) {
+        return;
+    }
+    const bool styled =
+        s_style == kStyleEnhanced && (in_menu ? s_scope != kScopeOutOfMenus : s_scope != kScopeInMenus);
+    const Look& look = styled ? kEnhanced : kVanilla;
+    const bool recapture = g_mod_mouse.turn_over != look.turn_over || g_mod_mouse.click_tilt != look.click_tilt;
+
+    g_mod_mouse.size = look.size;
+    g_mod_mouse.flip_x = look.flip_x;
+    g_mod_mouse.flip_y = look.flip_y;
+    g_mod_mouse.rotation = look.rotation;
+    g_mod_mouse.shift_x = look.shift_x;
+    g_mod_mouse.shift_y = look.shift_y;
+    g_mod_mouse.turn_over = look.turn_over;
+    g_mod_mouse.click_tilt = look.click_tilt;
+    g_mod_mouse.click_speed = look.click_speed;
+#ifdef MOUSE_INPUT
+    // The glove picture is captured once per pose; recapture it when the look changes how it is rendered.
+    if (recapture) {
+        aurora_mouse_cursor_invalidate();
+    }
+#endif
+}
+
+namespace {
+void apply_settings() {
+    // Only called while the mod is switched on (see mods.json), so this also enables its fixes.
+    g_mod_mouse.enabled = 1;
+    s_style = s.style->get();
+    s_scope = s.scope->get();
+    g_mod_mouse.hide_seconds = s.hideSeconds->get();
+    g_mod_mouse.right_click_aim = s.rightClickAim->get() ? 1 : 0;
+    g_mod_mouse.in_menus = s_scope != kScopeOutOfMenus;
+    mod_mouse_select_context(s_inMenu);
+}
+} // namespace
+
+ACGC_REGISTER_MOD(mouse_enhancements, .name = "Mouse Enhancements", .create_settings = create_settings,
+                  .apply_settings = apply_settings, .build_settings = build_settings);
